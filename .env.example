# Port for dev server and production ingress
PORT=3000

# Environment mode
NODE_ENV=development

# Firebase configuration (client-side)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Real-time WebSocket Relay URL for high-frequency (20Hz) vehicle coordinate streaming (Optional, falls back to port 3000 in dev)
VITE_VEHICLE_WS_URL=

# Optional public GLB override. Leave unset to use the existing R2/Lovable map.
VITE_RACING_MAP_URL=

# Optional full proxy endpoint. Default: same-origin /api/proxy.
# For Cloudflare: https://<your-worker-host>/api/proxy
VITE_ASSET_PROXY_URL=

# Server/worker only: extra approved HTTPS asset hostnames, comma-separated.
# The repository's R2 and Lovable asset hosts are already allowed.
ASSET_ALLOWED_HOSTS=
