{
  "$schema": "https://raw.githubusercontent.com/cloudflare/wrangler/main/config-schema.json",
  "name": "racing-game-vehicle-relay",
  "main": "worker.ts",
  "compatibility_date": "2024-12-18",
  "durable_objects": {
    "bindings": [
      {
        "name": "VEHICLE_ROOM",
        "class_name": "RoomDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDurableObject"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
