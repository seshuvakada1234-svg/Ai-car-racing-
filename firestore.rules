rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Standard high-quality reusable helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (request.auth.token.get('email_verified', false) == true || 'email' in request.auth.token);
    }

    function isUserRole(role) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == role;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email.lower() in ['seshuvakada1234@gmail.com', 'resumepro.ads@gmail.com']) ||
        isUserRole('admin')
      );
    }

    function isBroadcaster() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email.lower() in ['seshuvakada522@gmail.com', 'seshuvakada5@gmail.com']) ||
        isAdmin() ||
        isUserRole('broadcaster')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function getExpectedRole() {
      return !('email' in request.auth.token) ? 'user' :
             (request.auth.token.email.lower() == 'seshuvakada1234@gmail.com' || request.auth.token.email.lower() == 'resumepro.ads@gmail.com') ? 'admin' :
             ((request.auth.token.email.lower() == 'seshuvakada522@gmail.com' || request.auth.token.email.lower() == 'seshuvakada5@gmail.com') ? 'broadcaster' : 'user');
    }

    // USERS COLLECTION
    match /users/{userId} {
      // Individual users can retrieve their own profiles safely
      allow get: if isSignedIn() && request.auth.uid == userId;

      // Admins and broadcasters can read all profiles
      allow get: if isSignedIn() && (isAdmin() || isBroadcaster());

      // Only admins have search/listing privileges over all user email/PII profiles
      allow list: if isAdmin();

      // On creation or update, ensure they set a role they are eligible for.
      allow create, update: if isSignedIn() && request.auth.uid == userId && 
                    (request.resource.data.get('role', 'user') == 'user' || 
                     request.resource.data.get('role', 'user') == getExpectedRole());

      // Admins can perform structural updates on users
      allow update: if isAdmin();

      // Accounts can only be deleted by System Administrators
      allow delete: if isAdmin();
    }

    // LEADERBOARDS COLLECTION
    match /leaderboards/{docId} {
      // Leaderboard highscores are publicly queryable by authenticated users
      allow read, list: if isSignedIn();

      // Authenticated racers can request addition of racing scorecard
      allow create: if isSignedIn() && 
                    request.resource.data.keys().hasAll(['playerName', 'selectedCar', 'topSpeed', 'createdAt']) &&
                    request.resource.data.keys().size() == 4 &&
                    request.resource.data.topSpeed is int &&
                    request.resource.data.topSpeed >= 0 &&
                    request.resource.data.topSpeed <= 1000 &&
                    request.resource.data.playerName is string &&
                    request.resource.data.playerName.size() <= 100 &&
                    request.resource.data.selectedCar is string &&
                    request.resource.data.selectedCar.size() <= 100 &&
                    request.resource.data.createdAt == request.time;

      // Restrict update modifications (scores are immutable)
      allow update: if false;

      // Only admins can delete/clean up records
      allow delete: if isAdmin();
    }

    // MAPS COLLECTION
    match /maps/{mapId} {
      // Racing tracks can be listed by any racer
      allow read, list: if isSignedIn();

      // Creation/Update/Deletion are Admin operations
      allow create, update, delete: if isAdmin();
    }

    // CARS COLLECTION
    match /cars/{carId} {
      // Vehicle garage details are readable by anyone
      allow read, list: if isSignedIn();

      // Setup/Engineering updates on cars are Admin operations
      allow create, update, delete: if isAdmin();
    }

    // ROOMS COLLECTION (Multiplayer Matched Staging Lobbies)
    match /rooms/{roomId} {
      // Any authenticated racer can read, list, create, or update room matchmaking staging states
      allow get, list, create, update: if isSignedIn();

      // Closing/purging a room can be done by any signed-in user to handle room teardown when either player leaves
      allow delete: if isSignedIn();

      // Dedicated rules for players subcollection
      match /players/{uid} {
        allow read, write: if isSignedIn();
      }
    }
    
    // LIVE COLLECTION (Broadcaster Live Syncing Metadata)
    match /live/{docId} {
      // Live current details are publicly queryable by authenticated users so they can auto-join
      allow read, get: if isSignedIn();

      // Only broadcaster or admin can write/update/delete live states
      allow write, create, update, delete: if isSignedIn() && (isAdmin() || isBroadcaster());
    }

    // ACTIVITY COLLECTION (Admin and Broadcaster Logs)
    match /activity/{docId} {
      allow read, list, create: if isSignedIn() && (isAdmin() || isBroadcaster());
      allow update, delete: if isAdmin();
    }

    // BROADCASTS COLLECTION (Video Transmission Feeds)
    match /broadcasts/{feedId} {
      allow read, list: if isSignedIn();
      allow write, create, update, delete: if isSignedIn() && (isAdmin() || isBroadcaster());
    }

    // SETTINGS COLLECTION (Platform Matchmaker Configurations)
    match /settings/{docId} {
      allow read, list: if isSignedIn();
      allow write, create, update, delete: if isAdmin();
    }

    // INVITATIONS COLLECTION (Pre-Allocated Operator Privileges)
    match /invitations/{docId} {
      allow read, list: if isSignedIn() && (isAdmin() || isBroadcaster());
      allow write, create, update, delete: if isAdmin();
    }
  }
}